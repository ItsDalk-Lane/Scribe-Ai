{
	"name": "scribe-ai",
	"version": "1.0.2",
	"description": "Run AI agent tasks in Obsidian with your configured model: read, search and edit notes, run commands, and use skills, web search and MCP servers.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/sync-vault.mjs",
		"test": "node scripts/test-bundle.mjs",
		"test:communication": "node scripts/test-bundle.mjs communication",
		"test:agent": "node scripts/test-bundle.mjs agent",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
