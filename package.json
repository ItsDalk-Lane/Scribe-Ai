		"https-proxy-agent": "9.1.0",
		"re2js": "2.10.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"smol-toml": "1.9.1",
		"socks-proxy-agent": "10.1.0",
		"yaml": "2.9.1",
